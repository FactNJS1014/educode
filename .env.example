# Database Connection (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/educode?sslmode=require"

# Authentication Secret for JWT session encryption
AUTH_SECRET="your-super-secret-random-key-at-least-32-chars-long"

# App Base URLs
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional Gemini AI API Key for code explanations
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
